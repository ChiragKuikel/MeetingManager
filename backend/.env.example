# Database (current, MySQL — being replaced by Postgres in Phase 1)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=meeting_summarizer
DB_PORT=3306

# Postgres + Redis (docker-compose.yml services — not wired into app code yet, Phase 1/3)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meeting_summarizer
# 5433 not 5432 — avoids clashing with a Postgres already running on the host
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/meeting_summarizer
# 6380 not 6379 — avoids clashing with a Redis already running on the host (oms-redis)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Server
PORT=3001
NODE_ENV=development
UPLOAD_DIR=uploads
MAX_FILE_SIZE=524288000

# Comma-separated list of allowed frontend origins for CORS. Update with the real
# deployed frontend URL(s) in Phase 8 — do not leave this as localhost in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Used only if you enable JWT verification in authMiddleware.ts (signing tokens).
# For local demo you can leave this or set any long random string, e.g. openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Optional: expected value for X-Api-Key header when you use authMiddleware API-key checks.
# Not required for Groq. Your app works without setting this to anything special while auth is off.
API_KEY=demo-key

# Required for real transcription + summarization (https://console.groq.com)
GROQ_API_KEY=

# Optional overrides (defaults work for most cases)
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# GROQ_CHAT_MODEL=llama-3.1-8b-instant

# Seeded dev user (prisma/seed.ts): dev@example.com / devpassword123
